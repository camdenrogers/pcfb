# Copy to .env and fill in. Never commit .env.

# Free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# Protects POST /api/admin/refresh (send as X-Admin-Token header)
ADMIN_TOKEN=change-me

POSTGRES_USER=pcfb
POSTGRES_PASSWORD=pcfb
POSTGRES_DB=pcfb

# Seasons of history to ingest (including the current one)
HISTORY_SEASONS=4
# Ingest + train automatically on first start if no model exists
AUTO_BOOTSTRAP=true
# Re-pull the current season and retrain every N hours (0 = off)
REFRESH_INTERVAL_HOURS=24
